---
import '../styles/global.css'
import { serializeJsonLd } from '../lib/catalog'

interface Props {
  title: string
  description: string
  canonicalPath: string
  imagePath?: string
  type?: 'website' | 'profile'
  noIndex?: boolean
  previousPath?: string
  nextPath?: string
  structuredData?: unknown
}

const {
  title,
  description,
  canonicalPath,
  imagePath = '/img/catalog-hero.webp',
  type = 'website',
  noIndex = false,
  previousPath,
  nextPath,
  structuredData,
} = Astro.props
const origin = Astro.site ?? Astro.url
const canonical = new URL(canonicalPath, origin).href
const image = new URL(imagePath, origin).href
const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'https://my.dietsystem.com.br'
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    {previousPath && <link rel="prev" href={new URL(previousPath, origin).href} />}
    {nextPath && <link rel="next" href={new URL(nextPath, origin).href} />}
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Encontre um Nutri | DietSystem" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" type="image/png" href="/img/logo.png" />
    {structuredData && <script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/nutricionistas" aria-label="DietSystem — catálogo de nutricionistas">
          <img src="/img/logo.png" alt="" width="32" height="32" />
          <span>DietSystem</span>
        </a>
        <nav class="header-nav" aria-label="Navegação principal">
          <a class="btn btn-primary btn-sm questions-link" href="/duvidas">Pergunte ao especialista</a>
          <a class="btn btn-outline btn-sm" href={`${appUrl}/login`}>Sou nutricionista</a>
        </nav>
      </div>
    </header>

    <div class="page-main"><slot /></div>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} DietSystem</span>
        <nav class="footer-links" aria-label="Links do rodapé">
          <a href="/duvidas">Pergunte ao especialista</a>
          <a href="/privacidade">Privacidade</a>
          <a href="/termos">Termos</a>
          <a class="text-link" href={`${appUrl}/login`}>Criar meu perfil</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
