<script>
  import { toReviewSignature } from '../lib/catalog'

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-async-form]')) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!form.reportValidity()) return
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')
      const status = form.querySelector<HTMLElement>('[data-form-status]')
      const success = form.querySelector<HTMLElement>('[data-form-success]')
      submit?.setAttribute('disabled', 'true')
      if (submit) submit.dataset.originalText = submit.textContent ?? ''
      if (submit) submit.textContent = 'Enviando…'
      if (status) { status.dataset.state = ''; status.textContent = '' }

      try {
        const data = new FormData(form)
        if (data.get('_initialsOnly') === 'on' && typeof data.get('patientName') === 'string') {
          data.set('patientName', toReviewSignature(String(data.get('patientName')), true))
        }
        const response = await fetch(form.action, { method: form.method, body: data, headers: { Accept: 'application/json' } })
        if (!response.ok) throw new Error('request_failed')
        form.reset()
        if (success) {
          form.querySelectorAll<HTMLElement>('[data-form-content]').forEach((node) => { node.hidden = true })
          success.hidden = false
        } else if (status) {
          status.dataset.state = 'success'
          status.textContent = form.dataset.successMessage ?? 'Enviado com sucesso.'
        }
      } catch {
        if (status) {
          status.dataset.state = 'error'
          status.textContent = form.dataset.errorMessage ?? 'Não foi possível enviar agora. Confirme os dados e tente novamente.'
        }
        if (window.hcaptcha) window.hcaptcha.reset()
      } finally {
        submit?.removeAttribute('disabled')
        if (submit) submit.textContent = submit.dataset.originalText ?? 'Enviar'
      }
    })
  }
</script>
