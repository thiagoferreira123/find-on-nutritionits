---
import type { CatalogSearch } from '../lib/catalog'
interface Props { search: CatalogSearch }
const { search } = Astro.props
const dirty = Boolean(search.name || search.specialty || search.city || search.state || search.priceMin || search.priceMax || search.online)
---
<form class="filters" method="get" action={Astro.url.pathname} data-catalog-filters>
  {search.seed && <input type="hidden" name="seed" value={search.seed} />}
  <div class="filter-heading">
    <span class="filter-title">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21v-7"/><path d="M4 10V3"/><path d="M12 21v-9"/><path d="M12 8V3"/><path d="M20 21v-5"/><path d="M20 12V3"/><path d="M1 14h6"/><path d="M9 8h6"/><path d="M17 16h6"/></svg>
      Filtre sua busca
    </span>
    {dirty && <a class="clear-button" href={Astro.url.pathname}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
      Limpar
    </a>}
  </div>
  <div class="filter-main">
    <input class="field" aria-label="Nome" name="name" value={search.name} maxlength="100" placeholder="Nome do profissional" data-auto-submit />
    <input class="field" aria-label="Especialidade" name="specialty" value={search.specialty} maxlength="100" placeholder="Especialidade" data-auto-submit />
    <input class="field" aria-label="Cidade" name="city" value={search.city} maxlength="64" placeholder="Cidade" data-auto-submit />
    <input class="field" aria-label="Estado" name="state" value={search.state} maxlength="2" placeholder="UF" data-auto-submit />
    <input class="field" aria-label="Preço mínimo" name="priceMin" value={search.priceMin} inputmode="decimal" placeholder="Preço mínimo" data-auto-submit />
    <input class="field" aria-label="Preço máximo" name="priceMax" value={search.priceMax} inputmode="decimal" placeholder="Preço máximo" data-auto-submit />
    <select class="filter-online" aria-label="Modalidade de atendimento" name="online" data-auto-submit>
      <option value="" selected={!search.online}>Online ou presencial</option>
      <option value="true" selected={search.online === 'true'}>Somente online</option>
      <option value="false" selected={search.online === 'false'}>Somente presencial</option>
    </select>
  </div>
  <button class="sr-only" type="submit">Aplicar filtros</button>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-catalog-filters]')
  const state = form?.querySelector<HTMLInputElement>('input[name="state"]')
  state?.addEventListener('input', () => { state.value = state.value.toUpperCase() })
  let submitTimer: number | undefined
  form?.querySelectorAll<HTMLElement>('[data-auto-submit]').forEach((field) => {
    const eventName = field instanceof HTMLSelectElement ? 'change' : 'input'
    field.addEventListener(eventName, () => {
      window.clearTimeout(submitTimer)
      submitTimer = window.setTimeout(() => form.requestSubmit(), eventName === 'input' ? 450 : 0)
    })
  })
</script>
