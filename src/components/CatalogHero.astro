---
interface Props { title?: string; description?: string }
const {
  title = 'Encontre um nutricionista de confiança',
  description = 'Profissionais verificados para acompanhamento online ou presencial, com avaliações de quem já foi atendido.',
} = Astro.props
---
<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-copy">
      <div class="hero-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3z"/><path d="m9 12 2 2 4-4"/></svg>
        Profissionais Premium verificados
      </div>
      <h1>{title}</h1>
      <p>{description}</p>
      <div class="hero-search-note">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        Busque por nome, especialidade ou cidade
      </div>
    </div>
  </div>
</section>
