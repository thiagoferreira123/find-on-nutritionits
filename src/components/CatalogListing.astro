---
import CatalogFilters from './CatalogFilters.astro'
import CatalogHero from './CatalogHero.astro'
import MetricScript from './MetricScript.astro'
import NutritionistCard from './NutritionistCard.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { catalogCardMatches, searchParams, type CatalogSearch, type CatalogSeoCopy } from '../lib/catalog'
import type { CatalogListResponse } from '../lib/types'

interface Props {
  search: CatalogSearch
  seo: CatalogSeoCopy
  response?: CatalogListResponse
  failed?: boolean
}

const { search, seo, response, failed = false } = Astro.props
const items = response?.items ?? []
const matchingItems = items.filter((profile) => catalogCardMatches(profile, search))
const cleanSearch = { ...search, seed: undefined, page: 1 }
const profileQuery = searchParams(cleanSearch).toString()
const specialties = [...new Set(items.flatMap((profile) => profile.specialties).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'pt-BR'))
const cities = [...new Set(items.map((profile) => profile.city).filter((value): value is string => Boolean(value)))].sort((a, b) => a.localeCompare(b, 'pt-BR'))
const states = [...new Set(items.map((profile) => profile.state).filter((value): value is string => Boolean(value)))].sort((a, b) => a.localeCompare(b, 'pt-BR'))
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: seo.heading,
  description: seo.description,
  numberOfItems: matchingItems.length,
  itemListElement: matchingItems.map((profile, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/nutricionistas/${profile.slug}`, Astro.site ?? Astro.url).href,
    name: profile.displayName,
  })),
}
---
<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath={seo.canonicalPath}
  structuredData={structuredData}
>
  <main>
    <CatalogHero title={seo.heading} description={seo.intro} />
    <section class="container listing" aria-labelledby="catalog-results-title">
      <CatalogFilters
        search={{ ...search, seed: response?.seed ?? search.seed }}
        specialties={specialties}
        cities={cities}
        states={states}
      />

      <div class="results-head">
        <div>
          <p class="results-eyebrow">Profissionais do DietSystem</p>
          <h2 id="catalog-results-title">Nutricionistas disponíveis</h2>
        </div>
        {response && <p data-results-count>{matchingItems.length} {matchingItems.length === 1 ? 'profissional encontrado' : 'profissionais encontrados'}</p>}
      </div>

      {failed && <div class="error-state" role="alert">
        <h2>Não foi possível carregar os profissionais</h2>
        <p>Verifique sua conexão e tente novamente em instantes.</p>
        <a class="btn btn-outline btn-sm state-action" href={Astro.url.pathname + Astro.url.search}>Tentar novamente</a>
      </div>}

      {!failed && items.length === 0 && <div class="empty-state">
        <h2>Nenhum perfil disponível no momento</h2>
        <p>Novos profissionais são adicionados ao catálogo regularmente.</p>
      </div>}

      {!failed && items.length > 0 && <>
        <div class="card-grid" data-catalog-grid>
          {items.map((profile) => <NutritionistCard
            profile={profile}
            query={profileQuery}
            whatsappContext={search.specialty}
            visible={catalogCardMatches(profile, search)}
          />)}
        </div>

        <div class="empty-state filter-empty-state" data-filter-empty hidden={matchingItems.length > 0}>
          <h2>Nenhum profissional combina com esses filtros</h2>
          <p>Remova um critério ou amplie a faixa de valor para ver mais opções.</p>
          <button class="btn btn-outline btn-sm state-action" type="button" data-empty-clear>Limpar filtros</button>
        </div>
      </>}
    </section>
  </main>
  <MetricScript eventType="page_view" />
</BaseLayout>

<script>
  import { CATALOG_WHATSAPP_MESSAGE } from '../lib/catalog'

  const form = document.querySelector<HTMLFormElement>('[data-catalog-filters]')
  const cards = [...document.querySelectorAll<HTMLElement>('[data-profile-card]')]
  const resultsCount = document.querySelector<HTMLElement>('[data-results-count]')
  const filterStatus = document.querySelector<HTMLElement>('[data-filter-status]')
  const filterEmpty = document.querySelector<HTMLElement>('[data-filter-empty]')
  const clearButton = document.querySelector<HTMLElement>('[data-clear-filters]')
  const emptyClearButton = document.querySelector<HTMLButtonElement>('[data-empty-clear]')
  const advancedCount = document.querySelector<HTMLElement>('[data-advanced-count]')
  const resultsTitle = document.querySelector<HTMLElement>('#catalog-results-title')
  const advanced = form?.querySelector<HTMLDetailsElement>('details.advanced')
  const stateInput = form?.elements.namedItem('state') as HTMLInputElement | null
  const priceMinInput = form?.elements.namedItem('priceMin') as HTMLInputElement | null
  const priceMaxInput = form?.elements.namedItem('priceMax') as HTMLInputElement | null

  const normalize = (value: string | undefined) => value?.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('pt-BR').trim() ?? ''
  const inputValue = (name: string) => {
    const field = form?.elements.namedItem(name)
    return field instanceof RadioNodeList ? field.value.trim() : field instanceof HTMLInputElement ? field.value.trim() : ''
  }
  const parseMoney = (value: string) => {
    const clean = value.replace(',', '.')
    return clean && /^\d+(?:\.\d+)?$/.test(clean) ? Number(clean) : undefined
  }

  const currentParams = () => {
    const params = new URLSearchParams()
    for (const name of ['name', 'specialty', 'city', 'state', 'priceMin', 'priceMax', 'online']) {
      const value = inputValue(name)
      if (value) params.set(name, name === 'state' ? value.toUpperCase() : value)
    }
    return params
  }

  const syncLinks = (params: URLSearchParams) => {
    const query = params.toString()
    document.querySelectorAll<HTMLAnchorElement>('[data-profile-link]').forEach((link) => {
      const path = link.dataset.profilePath
      if (path) link.href = `${path}${query ? `?${query}` : ''}`
    })
    document.querySelectorAll<HTMLAnchorElement>('[data-whatsapp-link]').forEach((link) => {
      const url = new URL(link.href)
      url.searchParams.set('text', `${CATALOG_WHATSAPP_MESSAGE}${params.get('specialty') ?? ''}`)
      link.href = url.href
    })
  }

  const applyFilters = (updateUrl = true) => {
    if (!form || cards.length === 0) return

    const name = normalize(inputValue('name'))
    const specialty = normalize(inputValue('specialty'))
    const city = normalize(inputValue('city'))
    const state = inputValue('state').toUpperCase()
    const online = inputValue('online')
    const priceMinText = inputValue('priceMin')
    const priceMaxText = inputValue('priceMax')
    const priceMin = parseMoney(priceMinText)
    const priceMax = parseMoney(priceMaxText)
    const invalidMinimum = Boolean(priceMinText) && priceMin === undefined
    const invalidMaximum = Boolean(priceMaxText) && priceMax === undefined
    const invalidRange = priceMin !== undefined && priceMax !== undefined && priceMin > priceMax
    const invalidPrice = invalidMinimum || invalidMaximum || invalidRange

    priceMinInput?.toggleAttribute('aria-invalid', invalidMinimum || invalidRange)
    priceMaxInput?.toggleAttribute('aria-invalid', invalidMaximum || invalidRange)

    let visibleCount = 0
    for (const card of cards) {
      const data = card.dataset
      const cardMinimum = data.priceMin === '' ? undefined : Number(data.priceMin)
      const cardMaximum = data.priceMax === '' ? undefined : Number(data.priceMax)
      const priceFloor = cardMinimum ?? cardMaximum
      const priceCeiling = cardMaximum ?? cardMinimum
      const matches = !invalidPrice
        && (!name || normalize(data.name).includes(name))
        && (!specialty || normalize(data.specialties).split('|').some((item) => item.includes(specialty)))
        && (!city || normalize(data.city).includes(city))
        && (!state || data.state?.toUpperCase() === state)
        && (!online || data.online === online)
        && (priceMin === undefined || (priceCeiling !== undefined && priceCeiling >= priceMin))
        && (priceMax === undefined || (priceFloor !== undefined && priceFloor <= priceMax))

      card.hidden = !matches
      if (matches) visibleCount += 1
    }

    const countLabel = `${visibleCount} ${visibleCount === 1 ? 'profissional encontrado' : 'profissionais encontrados'}`
    if (resultsCount) resultsCount.textContent = countLabel
    if (filterStatus) {
      filterStatus.textContent = invalidPrice
        ? invalidRange ? 'O valor mínimo deve ser menor que o valor máximo.' : 'Informe apenas números nos campos de valor.'
        : countLabel
      filterStatus.classList.toggle('filter-status-error', invalidPrice)
    }
    if (filterEmpty) filterEmpty.hidden = visibleCount > 0 || invalidPrice

    const params = currentParams()
    const dirty = params.size > 0
    if (clearButton) clearButton.hidden = !dirty
    const activeAdvanced = ['state', 'priceMin', 'priceMax'].filter((name) => inputValue(name)).length
    if (advancedCount) {
      advancedCount.textContent = String(activeAdvanced)
      advancedCount.hidden = activeAdvanced === 0
    }
    syncLinks(params)

    if (updateUrl) {
      const url = new URL(window.location.href)
      url.search = params.toString()
      window.history.replaceState({}, '', url)
    }
  }

  const clearFilters = () => {
    if (!form) return
    form.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
      if (input.type === 'radio') input.checked = input.value === ''
      else input.value = ''
      input.removeAttribute('aria-invalid')
    })
    if (advanced) advanced.open = false
    applyFilters()
  }

  let frame = 0
  const scheduleFilter = () => {
    window.cancelAnimationFrame(frame)
    frame = window.requestAnimationFrame(() => applyFilters())
  }

  form?.addEventListener('input', scheduleFilter)
  form?.addEventListener('change', scheduleFilter)
  form?.addEventListener('submit', (event) => {
    event.preventDefault()
    applyFilters()
    resultsTitle?.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' })
  })
  clearButton?.addEventListener('click', (event) => { event.preventDefault(); clearFilters() })
  emptyClearButton?.addEventListener('click', clearFilters)
  stateInput?.addEventListener('input', () => { stateInput.value = stateInput.value.toUpperCase() })
  applyFilters(false)
</script>
